# ---- SSR Agent ----------------------------------------------------------
# Model provider key for the SSR agent (Gemini by default).
GEMINI_API_KEY=
# Optional web-search provider.
TAVILY_API_KEY=
# Default model id (see ssr-agent docs).
DEFAULT_MODEL=gemini-3.1-flash-lite

# Which ssr-agent ref the SSR image installs (the branch carrying the Miloco
# integration). Override to pin a tag/commit.
SSR_REF=claude/fervent-galileo-psbk39

# ---- Miloco wiring ------------------------------------------------------
# Where SSR reaches the Miloco REST API.
#  - compose network:   http://miloco:1810   (default in docker-compose.yml)
#  - Miloco on the host: http://host.docker.internal:1810
MILOCO_BASE_URL=http://miloco:1810

# Optional bearer token if your Miloco API requires one.
MILOCO_API_KEY=

# ---- Miloco models ------------------------------------------------------
# Miloco's multimodal perception/agent model key (MiMo recommended). Required
# for Miloco's own reasoning; see the Miloco docs.
MILOCO_OMNI_API_KEY=
