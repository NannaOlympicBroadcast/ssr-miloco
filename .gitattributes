# Normalize line endings. Shell scripts MUST stay LF even when checked out on
# Windows (autocrlf), otherwise the shebang becomes `#!/usr/bin/env bash\r` and
# the kernel looks for a command literally named `bash\r` ("bash\r: No such
# file or directory"). ssr-miloco is run on Windows via Docker, so this matters.
* text=auto eol=lf
*.sh text eol=lf
docker/ssr-entrypoint.sh text eol=lf
scripts/up.sh text eol=lf

# Binary-ish files git should not touch.
*.png binary
*.jpg binary
*.ico binary
